# --- Supabase (project URL + anon are public, service role + DB URL are secrets) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
SUPABASE_SERVICE_ROLE_KEY="ey..."

# Direct Postgres connection (used by Drizzle migrations + cron rollups)
# Use Supabase's "Connection pooling" string for the cron job, "Direct connection" for db:push.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Shared secret for Vercel Cron handler — generate a long random string
CRON_SECRET="change-me-to-a-long-random-string"

# Site URL (used by OAuth redirects). For local dev keep as below; in production set the deployed URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: bootstrap the first admin invite when running pnpm db:seed
SEED_ADMIN_EMAIL="you@example.com"
